JWT_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PUBLIC_API_URL=http://localhost:8080
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
# Firebase service-account JSON file, read via Application Default Credentials
# Firestore is the only database. Place the service-account JSON at this path.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Comma-separated origins allowed to call the API from a browser (e.g. https://admin.example.com).
# Empty (default) = no browser cross-origin access. The bundled admin panel is served from the API origin and needs no CORS.
CORS_ALLOWED_ORIGINS=
