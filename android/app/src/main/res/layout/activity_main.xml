<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#FBF7F2" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
  <TextView android:text="parlour." android:textSize="28sp" android:textStyle="bold" android:textColor="#643C57" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <Button android:id="@+id/home" android:text="Home" android:layout_width="wrap_content" android:layout_height="48dp"/>
 </LinearLayout>
 <ProgressBar android:id="@+id/loading" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" android:visibility="gone" android:layout_width="match_parent" android:layout_height="3dp"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:id="@+id/content" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
 <LinearLayout android:orientation="horizontal" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <Button android:id="@+id/bookings" android:text="Bookings" android:layout_weight="1" android:layout_width="0dp" android:layout_height="52dp"/>
  <Button android:id="@+id/inbox" android:text="Updates" android:layout_weight="1" android:layout_width="0dp" android:layout_height="52dp"/>
  <Button android:id="@+id/account" android:text="Account" android:layout_weight="1" android:layout_width="0dp" android:layout_height="52dp"/>
 </LinearLayout>
</LinearLayout>
